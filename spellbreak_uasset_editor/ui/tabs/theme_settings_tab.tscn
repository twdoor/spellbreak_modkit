[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/tabs/theme_settings_tab.gd" id="1_theme"]
[ext_resource type="Script" uid="uid://nlpwhurtsbly" path="res://ui/components/smooth_scroll_container.gd" id="2_scroll"]

[node name="ThemeSettingsTab" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 0
script = ExtResource("1_theme")

[node name="ThemeScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
script = ExtResource("2_scroll")

[node name="ContentMargin" type="MarginContainer" parent="ThemeScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Content" type="VBoxContainer" parent="ThemeScroll/ContentMargin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="ThemeTitle" type="Label" parent="ThemeScroll/ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Theme"

[node name="ThemeHint" type="Label" parent="ThemeScroll/ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Customize a compact palette and shared size scale. Related UI roles are derived automatically. Changes preview live; save to update colors.json and theme.json."

[node name="ColorsTitle" type="Label" parent="ThemeScroll/ContentMargin/Content"]
layout_mode = 2
text = "Colors"

[node name="ColorsContainer" type="VBoxContainer" parent="ThemeScroll/ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="MetricsTitle" type="Label" parent="ThemeScroll/ContentMargin/Content"]
layout_mode = 2
text = "Sizing and Spacing"

[node name="MetricsContainer" type="VBoxContainer" parent="ThemeScroll/ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="StatusLabel" type="Label" parent="ThemeScroll/ContentMargin/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="FooterSeparator" type="HSeparator" parent="."]
layout_mode = 2

[node name="FooterMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 8

[node name="Footer" type="HBoxContainer" parent="FooterMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SaveButton" type="Button" parent="FooterMargin/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Save"

[node name="DefaultsButton" type="Button" parent="FooterMargin/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Restore Defaults"

[node name="CloseButton" type="Button" parent="FooterMargin/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Close"

[connection signal="pressed" from="FooterMargin/Footer/SaveButton" to="." method="_on_save_pressed"]
[connection signal="pressed" from="FooterMargin/Footer/DefaultsButton" to="." method="_on_defaults_pressed"]
[connection signal="pressed" from="FooterMargin/Footer/CloseButton" to="." method="_on_close_pressed"]
